ignores: [
  '#src/*',

  '@tsconfig/node24',
  '@typescript-eslint/eslint-plugin',
  '@typescript-eslint/parser',
  'typescript',
  'typescript-transform-paths',

  '@commitlint/cli',
  '@commitlint/config-angular',
  '@skilbjo/config-rc',
  'husky',

  # transitive dependency of @skilbjo/config-rc's eslint config; nothing here
  # imports it by name, but a fresh `npm ci` no longer hoists it to the top
  # level so it has to be declared explicitly to keep lint's import resolver
  # working (see 2c65942)
  'eslint-import-resolver-typescript',

  'nodemon',
]
