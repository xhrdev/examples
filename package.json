{
  "$schema": "https://json.schemastore.org/package",
  "name": "@xhrdev/examples",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhrdev/examples.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "npx playwright install --with-deps chrome",
    "depcheck": "depcheck",
    "eslint": "eslint .",
    "exec": "node",
    "build": "tsgo -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "node --test",
    "grainger": "node --env-file=.env src/datadome/grainger-http.ts",
    "grainger:browser": "node --env-file=.env src/datadome/grainger.ts",
    "idealista": "node --env-file=.env src/datadome/idealista.ts",
    "comcast": "node --env-file=.env src/akamai/comcast.ts",
    "ca-edd": "node --env-file=.env src/akamai/ca-edd.ts",
    "loadtest": "node --env-file=.env src/loadtest.ts",
    "prepare": "husky"
  },
  "author": "XHR Software Inc",
  "dependencies": {
    "playwright-core": "1.62.1",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-angular": "21.2.0",
    "@skilbjo/config-rc": "1.0.56",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "26.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "depcheck": "1.4.7",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "playwright": "1.62.1"
  },
  "imports": {
    "#src/*.js": {
      "node": "./src/*.ts",
      "import": "./dist/*.js",
      "types": "./src/*.ts"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-angular"
    ]
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
