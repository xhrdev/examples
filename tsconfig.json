{
  "extends": "@skilbjo/config-rc/tsconfig.json",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dev-resources/repl.cjs",
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "lib": ["ES2025", "DOM"],
    "rootDir": "./src",
    "paths": {
      "#src/*": ["./src/*"]
    },
    "types": [
      "node"
    ]
  }
}
