# Copy to .env and fill in. Every example reads its config from here:
#
#   node --env-file=.env src/datadome/grainger-http.ts

## --- required ---------------------------------------------------------------

# Host or IP running the xhr.dev container. The examples talk to port 3000.
host=<solver-host-or-ip>

# Upstream proxy the examples egress through. Bot vendors bind their clearance
# cookies to the egress IP, so this must be the same network you scrape from.
#
# The examples pin a sticky session automatically for oxylabs (`-sessid-`) and
# rayobyte (`-hardsession-`); with any other provider, make sure the pool does
# not rotate mid-flow or the cookie you earn will be void.
#
# Datacenter IPs are faster, but some sites do not bother challenging them at
# all — use a residential pool if you want to exercise the solve path.
proxy=http://<user>:<pass>@<proxy-host>:<port>

## --- optional ---------------------------------------------------------------

# Cosmetic label for the proxy, used to name it in the run log (e.g.
# "OXYLABS = SOLVED"). Defaults to "PROXY".
# proxy_label=OXYLABS

# Only if your deployment gates the solver behind an API key (sent as
# `x-api-key`). Leave unset for an ungated container on a private network.
# solver_api_key=<issued-key>

# Credentials for the Akamai login example (src/akamai/ca-edd.ts).
# username=<edd-login-username>
# password=<edd-login-password>

# Browser-based examples only. Point at an installed Chrome instead of the
# Playwright-managed build, and keep the window open after a run to inspect it.
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# BROWSER_HOLD_MS=30000

# The `:lightpanda` examples only. `npm install` downloads the binary to bin/,
# and $PATH is checked after that — set this to use a copy from somewhere else.
# LIGHTPANDA_PATH=/usr/local/bin/lightpanda
